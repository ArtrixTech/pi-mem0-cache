{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // Unused bindings accumulate silently through a module split: the import
    // stayed behind when its use moved, and the typecheck stayed green because
    // this flag was off.
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
